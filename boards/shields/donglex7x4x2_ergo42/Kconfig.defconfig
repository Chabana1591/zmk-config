if SHIELD_DONGLEX7X4X2_ERGO42_LEFT

config ZMK_KEYBOARD_NAME
    default "donglex7x4x2_ergo42"

config ZMK_SPLIT_ROLE_CENTRAL
    default y

# 外部デバイス(5台) + 子機(右手) = 6
config BT_MAX_CONN
    default 6

config BT_MAX_PAIRED
    default 6

endif # SHIELD_DONGLEX7X4X2_ERGO42_LEFT

if SHIELD_DONGLEX7X4X2_ERGO42_LEFT || SHIELD_DONGLEX7X4X2_ERGO42_RIGHT

config ZMK_SPLIT
    default y

endif # SHIELD_DONGLEX7X4X2_ERGO42_LEFT || SHIELD_DONGLEX7X4X2_ERGO42_RIGHT

if SHIELD_DONGLEX7X4X2_ERGO42_DONGLE

config ZMK_KEYBOARD_NAME
    default "donglex7x4x2_ergo42"

config ZMK_SPLIT_ROLE_CENTRAL
    default y

config ZMK_SPLIT
    default y

# Left and right halves = 2 peripherals
config ZMK_SPLIT_BLE_CENTRAL_PERIPHERALS
    default 2

# ZMK_SPLIT_BLE_CENTRAL_PERIPHERALS + desired BT profiles (5)
config BT_MAX_CONN
    default 7

# Same as BT_MAX_CONN
config BT_MAX_PAIRED
    default 7

if ZMK_DISPLAY

config I2C
    default y

config SSD1306
    default y

endif # ZMK_DISPLAY

if LVGL

config LV_Z_VDB_SIZE
    default 64

config LV_DPI_DEF
    default 148

config LV_Z_BITS_PER_PIXEL
    default 1

choice LV_COLOR_DEPTH
    default LV_COLOR_DEPTH_1
endchoice

endif # LVGL

endif # SHIELD_DONGLEX7X4X2_ERGO42_DONGLE
