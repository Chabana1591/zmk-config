if SHIELD_DONGLEX7X4X2_LEFT

config ZMK_KEYBOARD_NAME
    default "donglex7x4x2"

config ZMK_SPLIT_ROLE_CENTRAL
    default y

# 外部デバイス(5台) + 子機(右手) = 6
config BT_MAX_CONN
    default 6

config BT_MAX_PAIRED
    default 6

endif # SHIELD_DONGLEX7X4X2_LEFT

if SHIELD_DONGLEX7X4X2_LEFT || SHIELD_DONGLEX7X4X2_RIGHT

config ZMK_SPLIT
    default y

endif # SHIELD_DONGLEX7X4X2_LEFT || SHIELD_DONGLEX7X4X2_RIGHT

if SHIELD_DONGLEX7X4X2_DONGLE

config ZMK_KEYBOARD_NAME
    default "donglex7x4x2"

config ZMK_SPLIT_ROLE_CENTRAL
    default y

config ZMK_SPLIT
    default y

# Left and right halves = 2 peripherals
config ZMK_SPLIT_BLE_CENTRAL_PERIPHERALS
    default 2

# ZMK_SPLIT_BLE_CENTRAL_PERIPHERALS + desired BT profiles (5)
config BT_MAX_CONN
    default 7

# Same as BT_MAX_CONN
config BT_MAX_PAIRED
    default 7

endif # SHIELD_DONGLEX7X4X2_DONGLE
