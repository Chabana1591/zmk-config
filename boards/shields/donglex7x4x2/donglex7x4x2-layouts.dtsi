// See https://zmk.dev/docs/development/hardware-integration/physical-layouts
// for how to configure this.

#include <physical_layouts.dtsi>

/ {
    default_layout: default_layout {
        compatible = "zmk,physical-layout";
        display-name = "Default Layout";
        transform = <&default_transform>;
        kscan = <&kscan>;

        // Edit this to define the positions and sizes of the keys, or remove it
        // if your keyboard will not support ZMK Studio.
        // https://zmk.dev/docs/development/hardware-integration/physical-layouts#optional-keys-property
        keys  //                     w   h    x    y     rot    rx    ry
            // Row 0 (Top)
            = <&key_physical_coords 0    0   0   0> // L01
            , <&key_physical_coords 100  0   0   0> // L02
            , <&key_physical_coords 200  0   0   0> // L03
            , <&key_physical_coords 300  0   0   0> // L04
            , <&key_physical_coords 400  0   0   0> // L05
            , <&key_physical_coords 500  0   0   0> // L06
            , <&key_physical_coords 600  0   0   0> // L07
            , <&key_physical_coords 800  0   0   0> // R01 (Gap of 1u)
            , <&key_physical_coords 900  0   0   0> // R02
            , <&key_physical_coords 1000 0   0   0> // R03
            , <&key_physical_coords 1100 0   0   0> // R04
            , <&key_physical_coords 1200 0   0   0> // R05
            , <&key_physical_coords 1300 0   0   0> // R06
            , <&key_physical_coords 1400 0   0   0> // R07

            // Row 1
            , <&key_physical_coords 0    100 0   0> // L08
            , <&key_physical_coords 100  100 0   0> // L09
            , <&key_physical_coords 200  100 0   0> // L10
            , <&key_physical_coords 300  100 0   0> // L11
            , <&key_physical_coords 400  100 0   0> // L12
            , <&key_physical_coords 500  100 0   0> // L13
            , <&key_physical_coords 600  100 0   0> // L14
            , <&key_physical_coords 800  100 0   0> // R08
            , <&key_physical_coords 900  100 0   0> // R09
            , <&key_physical_coords 1000 100 0   0> // R10
            , <&key_physical_coords 1100 100 0   0> // R11
            , <&key_physical_coords 1200 100 0   0> // R12
            , <&key_physical_coords 1300 100 0   0> // R13
            , <&key_physical_coords 1400 100 0   0> // R14

            // Row 2
            , <&key_physical_coords 0    200 0   0> // L15
            , <&key_physical_coords 100  200 0   0> // L16
            , <&key_physical_coords 200  200 0   0> // L17
            , <&key_physical_coords 300  200 0   0> // L18
            , <&key_physical_coords 400  200 0   0> // L19
            , <&key_physical_coords 500  200 0   0> // L20
            , <&key_physical_coords 600  200 0   0> // L21
            , <&key_physical_coords 800  200 0   0> // R15
            , <&key_physical_coords 900  200 0   0> // R16
            , <&key_physical_coords 1000 200 0   0> // R17
            , <&key_physical_coords 1100 200 0   0> // R18
            , <&key_physical_coords 1200 200 0   0> // R19
            , <&key_physical_coords 1300 200 0   0> // R20
            , <&key_physical_coords 1400 200 0   0> // R21

            // Row 3 (Bottom)
            , <&key_physical_coords 0    300 0   0> // L22
            , <&key_physical_coords 100  300 0   0> // L23
            , <&key_physical_coords 200  300 0   0> // L24
            , <&key_physical_coords 300  300 0   0> // L25
            , <&key_physical_coords 400  300 0   0> // L26
            , <&key_physical_coords 500  300 0   0> // L27
            , <&key_physical_coords 600  300 0   0> // L28
            , <&key_physical_coords 800  300 0   0> // R22
            , <&key_physical_coords 900  300 0   0> // R23
            , <&key_physical_coords 1000 300 0   0> // R24
            , <&key_physical_coords 1100 300 0   0> // R25
            , <&key_physical_coords 1200 300 0   0> // R26
            , <&key_physical_coords 1300 300 0   0> // R27
            , <&key_physical_coords 1400 300 0   0> // R28
            ;
    };
};
